{
  "name": "@halvardm/noa",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "nodeModulesDir": "none",
  "tasks": {
    "run": "deno run --allow-net --allow-sys=systemMemoryInfo --allow-env=NOA_HOME,HOME,MISTRAL_API_KEY,ANTHROPIC_API_KEY,OLLAMA_HOST --allow-read=$PWD,$HOME/.config/noa --allow-write=$PWD,$HOME/.config/noa --allow-run=ls,cat,head,tail,wc,grep,find,jq,curl,date src/main.ts",
    "dev": "deno run -A --watch src/main.ts",
    "compile:base": "deno compile --allow-net --allow-sys=systemMemoryInfo --allow-env --allow-read --allow-write --bundle --minify --app-name noa",
    "compile:darwin:aarch": "deno task compile:base --target aarch64-apple-darwin --output ./dist/noa src/main.ts",
    "compile": "deno task compile:darwin:aarch",
    "test": "deno test -A"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@stdx/cli": "jsr:@stdx/cli@^0.1.1",
    "zod": "jsr:@zod/zod@^4.1.12"
  }
}
