{
  "name": "@halvardm/noa",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "nodeModulesDir": "none",
  "tasks": {
    "noa": "deno run --allow-net --allow-env=NOA_HOME,NOA_TOOLS,NOA_ALLOW_PATHS,HOME,MISTRAL_API_KEY,OLLAMA_HOST --allow-read=$PWD,$HOME/.config/noa --allow-write=$PWD,$HOME/.config/noa --allow-run=ls,cat,head,tail,wc,grep,find,jq,curl src/main.ts",
    "dev": "deno run -A --watch src/main.ts",
    "compile": "deno compile -A --output compiled/noa src/main.ts",
    "test": "deno test -A"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@stdx/cli": "jsr:@stdx/cli@^0.1.1"
  }
}
