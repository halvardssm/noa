{
  "name": "@halvardm/noa",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./cli.ts",
  "publish": {
    "include": [
      "src/**",
      "cli.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "nodeModulesDir": "none",
  "tasks": {
    "run": "deno run -A cli.ts",
    "dev": "deno run -A --watch cli.ts",
    "compile:base": "deno compile -A --bundle --minify --app-name noa",
    "compile:darwin:aarch": "deno task compile:base --target aarch64-apple-darwin --output ./dist/noa cli.ts",
    "compile": "deno task compile:darwin:aarch",
    "test": "deno test -A"
  },
  "imports": {
    "@logtape/logtape": "jsr:@logtape/logtape@^2.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/async": "jsr:@std/async@^1.5.1",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@stdx/cli": "jsr:@stdx/cli@^0.1.1",
    "@stdx/fs": "jsr:@stdx/fs@^0.1.1",
    "ollama": "npm:ollama@^0.6.4",
    "zod": "jsr:@zod/zod@^4.1.12"
  }
}
